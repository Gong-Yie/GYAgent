# Configuration schema. Unsupported versions fail during startup.
SC_CONFIG_VERSION=1
SC_DATA_DIR=data

# Comma-separated concrete module IDs, or "all".
SC_ENABLED_MODULES=all

# The background worker is optional; the one-shot CLI leaves it disabled.
SC_WORKER_ENABLED=false
SC_WORKER_POLL_INTERVAL_SECONDS=0.1
SC_WORKER_MAX_WORKERS=4

# Runtime credentials stay in .env/environment and are never copied into state.
OPENAI_API_KEY=
