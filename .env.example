# 将此文件复制为 .env。不要在此示例或备份中放入真实凭证。
# 配置结构版本；使用不支持的版本会导致启动失败。
SC_CONFIG_VERSION=1
SC_DATA_DIR=data

# 填写以逗号分隔的具体模块 ID，或填写 "all"。
SC_ENABLED_MODULES=all

# 后台 worker 是可选的；单次运行的 CLI 默认不启用它。
SC_WORKER_ENABLED=false
SC_WORKER_POLL_INTERVAL_SECONDS=0.1
SC_WORKER_MAX_WORKERS=4

# 运行时凭证只保存在 .env 或环境变量中，绝不会复制到认知状态。
OPENAI_API_KEY=
# 对话、规划、动作、元认知和情感 Agent 共用的模型名。
OPENAI_MODEL=
# 可选；留空时使用 OpenAI SDK 的默认 API 地址，只填写可信的兼容端点。
OPENAI_BASE_URL=
